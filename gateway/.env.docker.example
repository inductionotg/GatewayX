# Local HTTP demonstration only. Production requires HTTPS and NODE_ENV=production.
PORT=3000
NODE_ENV=development
PRODUCT_SERVICE_URLS=http://product-service:3002,http://product-service-2:3002
REVIEW_SERVICE_URL=http://review-service:3003
USER_SERVICE_URLS=http://user-service:3001
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_TIMEOUT_MS=10000
DOWNSTREAM_TIMEOUT_MS=2000
REDIS_URL=redis://redis:6379
SESSION_COOKIE_NAME=gatewayx.docker.sid
SESSION_TTL_SECONDS=1800
SESSION_REDIS_PREFIX=gatewayx:docker:sessions:
SESSION_REDIS_TIMEOUT_MS=2000
# Generate a random secret; copy the same value to all gateway instances.
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
RATE_LIMIT_PREFIX=gatewayx:docker:rate:
RATE_LIMIT_USER_CAPACITY=10
RATE_LIMIT_USER_REFILL_PER_SECOND=2
RATE_LIMIT_ANONYMOUS_CAPACITY=20
RATE_LIMIT_ANONYMOUS_REFILL_PER_SECOND=1
RATE_LIMIT_AUTH_CAPACITY=5
RATE_LIMIT_AUTH_REFILL_PER_SECOND=0.1
RATE_LIMIT_REDIS_TIMEOUT_MS=2000
