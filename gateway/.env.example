PORT=3200
NODE_ENV=development
PRODUCT_SERVICE_URLS=http://127.0.0.1:3102,http://127.0.0.1:3104
REVIEW_SERVICE_URL=http://127.0.0.1:3103
USER_SERVICE_URLS=http://127.0.0.1:3105
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_TIMEOUT_MS=10000
DOWNSTREAM_TIMEOUT_MS=2000
REDIS_URL=redis://127.0.0.1:6380
SESSION_COOKIE_NAME=gatewayx.sid
SESSION_TTL_SECONDS=1800
SESSION_REDIS_PREFIX=gatewayx:sessions:
SESSION_REDIS_TIMEOUT_MS=2000
# Generate a random secret; copy the same value to all gateway instances.
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
# Optional comma-separated proxy IPs; explicit addresses take precedence over hops.
TRUST_PROXY_ADDRESSES=
RATE_LIMIT_PREFIX=gatewayx:rate:
RATE_LIMIT_USER_CAPACITY=10
RATE_LIMIT_USER_REFILL_PER_SECOND=2
RATE_LIMIT_ANONYMOUS_CAPACITY=20
RATE_LIMIT_ANONYMOUS_REFILL_PER_SECOND=1
RATE_LIMIT_AUTH_CAPACITY=5
RATE_LIMIT_AUTH_REFILL_PER_SECOND=0.1
RATE_LIMIT_REDIS_TIMEOUT_MS=2000
