                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "if ([200, 201].includes(pm.response.code)) { pm.test('No password/hash in response', function () { const user=pm.response.json().data; pm.expect(user).not.to.have.property('password'); pm.expect(user).not.to.have.property('passwordHash'); }); }"
                ]
