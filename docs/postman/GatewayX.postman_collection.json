    {
      "name": "02 — Registration and shared-session walkthrough",
      "description": "Run in order with the Postman cookie jar enabled. Registration does not log in. Logout returns 204 with no body. The last request intentionally expects 401.",
      "item": [
        {
          "name": "1. Register user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/users",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Creates a demo user. Repeating registration returns 409. Clear the email environment variable to generate a fresh account.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([201,409]); });",
                  "if (pm.response.code === 201) { const id = pm.response.json().data.id; pm.collectionVariables.set('user_id', id); if (pm.environment.name) pm.environment.set('user_id', id); }",
                  "if ([200, 201].includes(pm.response.code)) { pm.test('No password/hash in response', function () { const user=pm.response.json().data; pm.expect(user).not.to.have.property('password'); pm.expect(user).not.to.have.property('passwordHash'); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login through gateway 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/auth/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Verifies credentials and sets gatewayx.sid. Postman saves the cookie automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "if ([200, 201].includes(pm.response.code)) { pm.test('No password/hash in response', function () { const user=pm.response.json().data; pm.expect(user).not.to.have.property('password'); pm.expect(user).not.to.have.property('passwordHash'); }); }",
                  "pm.test('Session cookie issued', function () { pm.expect(pm.response.headers.get('Set-Cookie')).to.include('gatewayx.sid='); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Current user — gateway 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/auth/me",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Requires the login cookie."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "if ([200, 201].includes(pm.response.code)) { pm.test('No password/hash in response', function () { const user=pm.response.json().data; pm.expect(user).not.to.have.property('password'); pm.expect(user).not.to.have.property('passwordHash'); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Same session — gateway 2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_2_url}}/api/auth/me",
              "host": [
                "{{gateway_2_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
