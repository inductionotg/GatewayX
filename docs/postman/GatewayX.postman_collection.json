            }
          ]
        },
        {
          "name": "5. Logout through gateway 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{gateway_2_url}}/api/auth/logout",
