    {
      "name": "05 — Rate-limit inspection (manual repeat)",
      "description": "Repeat requests quickly or run this folder with multiple iterations. 200 and 429 are both valid here; a single request does not guarantee 429. For the verified concurrent two-process test, run node scripts/session-live-demo.mjs --rate-limit. Login beforehand to test per-user rather than anonymous IP limits.",
      "item": [
        {
          "name": "Consume token — gateway 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/products",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "Inspect X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Policy and Retry-After on a rejection."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response is admitted or rate limited', function () { pm.expect(pm.response.code).to.be.oneOf([200,429]); });",
                  "if (pm.response.code === 429) { pm.test('Retry-After is a positive integer', function () { pm.expect(pm.response.headers.get('Retry-After')).to.match(/^[1-9][0-9]*$/); pm.expect(pm.response.json().error.code).to.eql('RATE_LIMIT_EXCEEDED'); }); }",
                  "console.log('Rate policy:', pm.response.headers.get('X-RateLimit-Policy'), 'Remaining:', pm.response.headers.get('X-RateLimit-Remaining'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same allowance — gateway 2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_2_url}}/api/products",
              "host": [
                "{{gateway_2_url}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "Uses the same user/IP allowance as gateway 1."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response is admitted or rate limited', function () { pm.expect(pm.response.code).to.be.oneOf([200,429]); });",
                  "if (pm.response.code === 429) { pm.test('Retry-After is a positive integer', function () { pm.expect(pm.response.headers.get('Retry-After')).to.match(/^[1-9][0-9]*$/); pm.expect(pm.response.json().error.code).to.eql('RATE_LIMIT_EXCEEDED'); }); }",
                  "console.log('Rate policy:', pm.response.headers.get('X-RateLimit-Policy'), 'Remaining:', pm.response.headers.get('X-RateLimit-Remaining'));"
                ]
              }
            }
          ]
        }
      ]
    },
