  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "for (const key of ['email', 'direct_email']) {",
          "  if (!pm.variables.get(key)) {",
          "    const value = pm.variables.replaceIn('postman-{{$guid}}@example.com');",
          "    pm.collectionVariables.set(key, value);",
          "    if (pm.environment.name) pm.environment.set(key, value);",
          "    pm.variables.set(key, value);",
          "  }",
          "}"
        ]
      }
    }
  ],
