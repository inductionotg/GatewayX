              "raw": "{{user_service_url}}/users",
              "host": [
                "{{user_service_url}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Uses direct_email so it does not conflict with the gateway walkthrough user.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Direct Postman User\",\n  \"email\": \"{{direct_email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([201,409]); });",
                  "if ([200, 201].includes(pm.response.code)) { pm.test('No password/hash in response', function () { const user=pm.response.json().data; pm.expect(user).not.to.have.property('password'); pm.expect(user).not.to.have.property('passwordHash'); }); }"
